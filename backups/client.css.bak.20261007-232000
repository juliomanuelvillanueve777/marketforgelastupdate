*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0d0d1a;color:#e0e0e0;min-height:100vh}
.client-layout{display:flex}
.sidebar{width:250px;min-height:100vh;background:#0a0a14;border-right:1px solid #1a1a2e;padding:0;display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100}
.sidebar-header{padding:24px 20px;border-bottom:1px solid #1a1a2e}
.logo-text{font-size:18px;color:#fff}
.logo-text strong{color:#4CAF50}
.sidebar-menu{padding:12px 0;flex:1;overflow-y:auto}
.sidebar-link{display:block;padding:10px 20px;color:#999;text-decoration:none;font-size:14px;transition:all 0.2s;border-left:3px solid transparent}
.sidebar-link:hover{background:#1a1a2e;color:#fff;border-left-color:#4CAF50}
.sidebar-link.active{background:#1a1a2e;color:#4CAF50;border-left-color:#4CAF50;font-weight:600}
.sidebar-link.logout{color:#e74c3c}
.main-content{margin-left:250px;padding:32px;flex:1;min-height:100vh}
h1{font-size:24px;margin-bottom:24px;color:#fff}
h2{font-size:18px;margin-bottom:12px;color:#ccc}
h3{font-size:16px;margin-bottom:8px;color:#aaa}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:24px}
.stat-card{background:#1a1a2e;padding:20px;border-radius:8px;border:1px solid #222;text-align:center}
.stat-num{font-size:32px;font-weight:700;color:#4CAF50;margin-bottom:4px}
.panel-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.panel{background:#1a1a2e;padding:20px;border-radius:8px;border:1px solid #222;margin-bottom:20px}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{text-align:left;padding:8px 12px;color:#888;border-bottom:1px solid #333;font-weight:500}
.data-table td{padding:8px 12px;border-bottom:1px solid #1a1a2e}
.data-table tr:hover{background:#0d0d1a}
.status-active{color:#4CAF50}
.status-pending{color:#f39c12}
.status-blocked{color:#e74c3c}
.status-unused{color:#3498db}
.status-used{color:#2ecc71}
.status-expired{color:#e74c3c}
.status-completed{color:#4CAF50}
.btn{display:inline-block;padding:10px 20px;border-radius:6px;border:none;cursor:pointer;font-size:14px;font-weight:600;text-decoration:none;transition:all 0.2s}
.btn-primary{background:#4CAF50;color:#fff}
.btn-primary:hover{background:#45a049}
.btn-danger{background:#e74c3c;color:#fff}
.btn-danger:hover{background:#c0392b}
.btn-success{background:#2ecc71;color:#fff}
.btn-sm{display:inline-block;padding:4px 10px;border-radius:4px;font-size:12px;text-decoration:none;font-weight:600}
label{display:block;color:#888;font-size:12px;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px}
input,select,textarea{padding:10px;background:#0d0d1a;border:1px solid #333;color:#fff;border-radius:6px;font-size:14px}
input:focus,select:focus,textarea:focus{outline:none;border-color:#4CAF50}
code{background:#0d0d1a;padding:2px 6px;border-radius:3px;font-size:12px;color:#4CAF50}

@media (max-width:768px){
  .sidebar{width:60px;overflow:hidden}
  .sidebar-link{font-size:0;padding:12px;text-align:center}
  .sidebar-link::first-letter{font-size:18px}
  .sidebar-header{display:none}
  .main-content{margin-left:60px}
  .panel-grid{grid-template-columns:1fr}
}
